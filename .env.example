# PostgreSQL usado pelo Prisma. Suba o banco com: docker compose up -d
DATABASE_URL="postgresql://ekanban:ekanban@localhost:5432/ekanban?schema=public"

# Segredo para o hash do token de sessão. Troque em produção por uma string longa e aleatória.
SESSION_SECRET="troque-este-segredo-por-uma-string-longa-e-aleatoria"

# URL pública usada nos QR Codes.
APP_URL="http://localhost:3000"
